<?xml version="1.0" encoding="UTF-8"?>
<?import javafx.scene.control.*?><?import javafx.scene.layout.*?><?import javafx.geometry.Insets?>
<BorderPane xmlns="http://javafx.com/javafx/21" xmlns:fx="http://javafx.com/fxml/1" fx:controller="org.paginalibre.controller.GestionAdministrativaController">
<top><HBox spacing="12" alignment="CENTER_LEFT" style="-fx-background-color:#263238;-fx-padding:14;"><Button text="← Regresar" onAction="#regresar"/><Label text="GESTIÓN ADMINISTRATIVA" style="-fx-text-fill:white;-fx-font-size:20px;-fx-font-weight:bold;"/></HBox></top>
<center><TabPane>
<tabs>
<Tab text="Categorías" closable="false"><content><VBox spacing="10"><padding><Insets top="15" right="15" bottom="15" left="15"/></padding><HBox spacing="8"><TextField fx:id="txtCatNombre" promptText="Nombre de categoría"/><Button text="Guardar / Editar" onAction="#guardarCategoria"/><Button text="Eliminar" onAction="#eliminarCategoria"/></HBox><TableView fx:id="tblCategorias" VBox.vgrow="ALWAYS" onMouseClicked="#seleccionarCategoria"><columns><TableColumn fx:id="cCatId" text="ID"/><TableColumn fx:id="cCatNombre" text="Categoría"/></columns></TableView></VBox></content></Tab>
<Tab text="Proveedores" closable="false"><content><VBox spacing="8"><padding><Insets top="15" right="15" bottom="15" left="15"/></padding><GridPane hgap="8" vgap="8"><Label text="Nombre" GridPane.rowIndex="0"/><TextField fx:id="txtProvNombre" GridPane.columnIndex="1"/><Label text="Teléfono" GridPane.rowIndex="1"/><TextField fx:id="txtProvTel" GridPane.columnIndex="1"/><Label text="Dirección" GridPane.rowIndex="2"/><TextField fx:id="txtProvDir" GridPane.columnIndex="1"/><Label text="Correo" GridPane.rowIndex="3"/><TextField fx:id="txtProvCorreo" GridPane.columnIndex="1"/></GridPane><HBox spacing="8"><Button text="Guardar / Editar" onAction="#guardarProveedor"/><Button text="Nuevo proveedor" onAction="#nuevoProveedor"/><Button text="Eliminar" onAction="#eliminarProveedor"/></HBox><TableView fx:id="tblProveedores" VBox.vgrow="ALWAYS" onMouseClicked="#seleccionarProveedor"><columns><TableColumn fx:id="cProvId" text="ID"/><TableColumn fx:id="cProvNombre" text="Proveedor"/><TableColumn fx:id="cProvTel" text="Teléfono"/><TableColumn fx:id="cProvDir" text="Dirección"/><TableColumn fx:id="cProvCorreo" text="Correo"/></columns></TableView></VBox></content></Tab>
<Tab text="Precios" closable="false"><content><VBox alignment="TOP_LEFT" spacing="12"><padding><Insets top="30" right="30" bottom="30" left="30"/></padding><Label text="Actualizar precio de un libro" style="-fx-font-size:18px;-fx-font-weight:bold;"/><TextField fx:id="txtIsbn" promptText="ISBN"/><TextField fx:id="txtNuevoPrecio" promptText="Nuevo precio (Q)"/><Button text="Actualizar precio" onAction="#actualizarPrecio"/></VBox></content></Tab>
</tabs></TabPane></center></BorderPane>
