<?xml version="1.0" encoding="UTF-8"?>

<?import javafx.geometry.Insets?>
<?import javafx.scene.control.Button?>
<?import javafx.scene.control.Label?>
<?import javafx.scene.control.TableColumn?>
<?import javafx.scene.control.TableView?>
<?import javafx.scene.control.TextField?>
<?import javafx.scene.layout.AnchorPane?>
<?import javafx.scene.layout.HBox?>
<?import javafx.scene.layout.VBox?>
<?import javafx.scene.text.Font?>

<AnchorPane prefHeight="600.0" prefWidth="800.0" xmlns="http://javafx.com/javafx/21" xmlns:fx="http://javafx.com/fxml/1" fx:controller="org.paginalibre.controller.HistorialVentasController">
   <children>
      <VBox spacing="15.0" AnchorPane.bottomAnchor="20.0" AnchorPane.leftAnchor="20.0" AnchorPane.rightAnchor="20.0" AnchorPane.topAnchor="20.0">
         <children>
            <HBox alignment="CENTER_LEFT" spacing="10.0">
               <children>
                  <Label text="Historial de Ventas">
                     <font>
                        <Font name="System Bold" size="22.0" />
                     </font>
                  </Label>
               </children>
            </HBox>
            <HBox alignment="CENTER_LEFT" spacing="10.0">
               <children>
                  <Label text="Buscar:" />
                  <TextField fx:id="txtBuscar" promptText="Buscar por ID Venta, CUI o Usuario..." HBox.hgrow="ALWAYS" />
                  <Button mnemonicParsing="false" onAction="#regresarDashboard" text="Regresar" />
               </children>
            </HBox>
            <TableView fx:id="tablaVentas" VBox.vgrow="ALWAYS">
              <columns>
                <TableColumn fx:id="colIdVenta" prefWidth="90.0" text="ID Venta" />
                <TableColumn fx:id="colFechaVenta" prefWidth="150.0" text="Fecha Venta" />
                <TableColumn fx:id="colCuiCliente" prefWidth="140.0" text="CUI Cliente" />
                <TableColumn fx:id="colIdUsuario" prefWidth="100.0" text="ID Usuario" />
                <TableColumn fx:id="colEstado" prefWidth="120.0" text="Estado" />
                <TableColumn fx:id="colTotal" prefWidth="120.0" text="Total (Q)" />
              </columns>
               <columnResizePolicy>
                  <TableView fx:constant="CONSTRAINED_RESIZE_POLICY" />
               </columnResizePolicy>
            </TableView>
         </children>
      </VBox>
   </children>
</AnchorPane>