<?xml version="1.0" encoding="UTF-8"?>

<?import javafx.geometry.Insets?>
<?import javafx.scene.control.Button?>
<?import javafx.scene.control.Label?>
<?import javafx.scene.control.TableColumn?>
<?import javafx.scene.control.TableView?>
<?import javafx.scene.control.TextField?>
<?import javafx.scene.layout.BorderPane?>
<?import javafx.scene.layout.HBox?>
<?import javafx.scene.layout.VBox?>

<BorderPane prefHeight="650.0" prefWidth="950.0" xmlns="http://javafx.com/javafx/21.0.1" xmlns:fx="http://javafx.com/fxml/1" fx:controller="org.paginalibre.controller.InventarioLibrosController">
   <top>
      <HBox alignment="CENTER_LEFT" spacing="15.0" BorderPane.alignment="CENTER">
         <padding>
            <Insets bottom="10.0" left="20.0" right="20.0" top="20.0" />
         </padding>
         <children>
            <Button fx:id="btnRegresar" onAction="#regresarDashboard" style="-fx-background-color: #6c757d; -fx-text-fill: white; -fx-font-weight: bold;" text="← Regresar" />
            <Label style="-fx-font-size: 22px; -fx-font-weight: bold;" text="Catálogo de Libros" />
         </children>
      </HBox>
   </top>
   
   <center>
      <VBox spacing="10.0" BorderPane.alignment="CENTER">
         <padding>
            <Insets bottom="20.0" left="20.0" right="20.0" top="5.0" />
         </padding>
         <children>
            <HBox alignment="CENTER_RIGHT" spacing="5.0">
               <children>
                  <Label text="Buscar:" />
                  <TextField fx:id="txtBuscar" prefWidth="250.0" promptText="Filtrar por ISBN o Título..." />
               </children>
            </HBox>
            
            <TableView fx:id="tablaLibros" VBox.vgrow="ALWAYS">
               <columns>
                  <TableColumn fx:id="colIsbn" prefWidth="130.0" text="ISBN" />
                  <TableColumn fx:id="colTitulo" prefWidth="300.0" text="Título" />
                  <TableColumn fx:id="colPrecio" prefWidth="100.0" text="Precio" />
                  <TableColumn fx:id="colStock" prefWidth="90.0" text="Stock" />
                  <TableColumn fx:id="colEditorial" prefWidth="130.0" text="Editorial" />
                  <TableColumn fx:id="colFecha" prefWidth="120.0" text="Fecha Pub." />
               </columns>
            </TableView>
         </children>
      </VBox>
   </center>
</BorderPane>