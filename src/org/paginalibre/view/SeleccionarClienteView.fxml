<?xml version="1.0" encoding="UTF-8"?>

<?import javafx.geometry.Insets?>
<?import javafx.scene.control.Button?>
<?import javafx.scene.control.Label?>
<?import javafx.scene.control.TableColumn?>
<?import javafx.scene.control.TableView?>
<?import javafx.scene.layout.HBox?>
<?import javafx.scene.layout.VBox?>

<VBox alignment="CENTER" spacing="15.0" prefWidth="600.0" prefHeight="380.0" 
      xmlns="http://javafx.com/javafx" xmlns:fx="http://javafx.com/fxml/1" 
      fx:controller="org.paginalibre.controller.SeleccionarClienteController">
   <padding>
      <Insets top="20.0" right="20.0" bottom="20.0" left="20.0" />
   </padding>
   <children>
      <Label text="Seleccione un Cliente" style="-fx-font-size: 16px; -fx-font-weight: bold;" />
      
      <TableView fx:id="tablaClientes" prefHeight="250.0" VBox.vgrow="ALWAYS">
        <columns>
          <TableColumn fx:id="colCui" prefWidth="120.0" text="CUI" />
          <TableColumn fx:id="colNombre" prefWidth="130.0" text="Nombre" />
            <TableColumn fx:id="colApellido" prefWidth="130.0" text="Apellido" />
            <TableColumn fx:id="colCorreo" prefWidth="180.0" text="Correo" />
        </columns>
      </TableView>

      <HBox alignment="CENTER_RIGHT" spacing="10.0">
         <children>
            <Button text="Cancelar" onAction="#handleCancelar" />
            <Button text="Seleccionar" onAction="#handleSeleccionar" 
                    style="-fx-background-color: #2f6fed; -fx-text-fill: white; -fx-font-weight: bold;" />
         </children>
      </HBox>
   </children>
</VBox>