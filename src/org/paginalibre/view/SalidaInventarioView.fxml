<?xml version="1.0" encoding="UTF-8"?>

<?import javafx.geometry.Insets?>
<?import javafx.scene.control.Button?>
<?import javafx.scene.control.ComboBox?>
<?import javafx.scene.control.Label?>
<?import javafx.scene.control.TableColumn?>
<?import javafx.scene.control.TableView?>
<?import javafx.scene.control.TextArea?>
<?import javafx.scene.control.TextField?>
<?import javafx.scene.layout.AnchorPane?>
<?import javafx.scene.layout.HBox?>
<?import javafx.scene.layout.VBox?>
<?import javafx.scene.text.Font?>

<AnchorPane prefHeight="650.0" prefWidth="950.0" style="-fx-background-color: #f4f6f9;" xmlns="http://javafx.com/dialogs" xmlns:fx="http://javafx.com/fxml/1" fx:controller="org.paginalibre.controller.SalidaInventarioController">
   <children>
      <!-- ENCABEZADO -->
      <AnchorPane prefHeight="70.0" prefWidth="950.0" style="-fx-background-color: #2c3e50;" AnchorPane.leftAnchor="0.0" AnchorPane.rightAnchor="0.0" AnchorPane.topAnchor="0.0">
         <children>
            <Button layoutX="20.0" layoutY="20.0" mnemonicParsing="false" onAction="#regresarDashboard" style="-fx-background-color: #34495e; -fx-text-fill: white; -fx-font-weight: bold; -fx-cursor: hand;" text="← REGRESAR" />
            <Label layoutX="140.0" layoutY="18.0" text="REGISTRO DE SALIDAS DE INVENTARIO" textFill="WHITE">
               <font>
                  <Font name="System Bold" size="22.0" />
               </font>
            </Label>
         </children>
      </AnchorPane>

      <!-- SECCIÓN IZQUIERDA: FORMULARIO -->
      <VBox layoutX="20.0" layoutY="90.0" prefWidth="350.0" spacing="12.0" style="-fx-background-color: white; -fx-background-radius: 8; -fx-effect: dropshadow(three-pass-box, rgba(0,0,0,0.1), 5, 0, 0, 0);" AnchorPane.bottomAnchor="20.0" AnchorPane.topAnchor="90.0">
         <padding>
            <Insets bottom="15.0" left="15.0" right="15.0" top="15.0" />
         </padding>
         <children>
            <Label text="Datos de la Salida" textFill="#2c3e50">
               <font>
                  <Font name="System Bold" size="18.0" />
               </font>
            </Label>
            
            <Label text="Buscar Libro (ISBN / Nombre):" textFill="#34495e">
               <font>
                  <Font name="System Bold" size="12.0" />
               </font>
            </Label>
            <HBox spacing="8.0">
               <children>
                  <TextField fx:id="txtBuscarLibro" onAction="#buscarLibroManual" promptText="Escribe ISBN o Nombre..." HBox.hgrow="ALWAYS" />
                  <Button mnemonicParsing="false" onAction="#buscarLibroManual" style="-fx-background-color: #3498db; -fx-text-fill: white; -fx-font-weight: bold; -fx-cursor: hand;" text="Buscar" />
               </children>
            </HBox>
            
            <Label fx:id="lblLibroSeleccionado" text="Ningún libro seleccionado" textFill="#2980b9">
               <font>
                  <Font name="System Bold" size="13.0" />
               </font>
            </Label>
            <Label fx:id="lblStockDisponible" text="Stock disponible: 0" textFill="#27ae60">
               <font>
                  <Font name="System Bold" size="12.0" />
               </font>
            </Label>
            
            <Label text="Tipo de Salida:" textFill="#34495e">
               <font>
                  <Font name="System Bold" size="12.0" />
               </font>
            </Label>
            <ComboBox fx:id="cbTipoSalida" maxWidth="1.7976931348623157E308" promptText="Seleccione tipo..." />
            
            <Label text="Cantidad:" textFill="#34495e">
               <font>
                  <Font name="System Bold" size="12.0" />
               </font>
            </Label>
            <TextField fx:id="txtCantidad" promptText="Ej. 10" />
            
            <Label text="Observación / Motivo:" textFill="#34495e">
               <font>
                  <Font name="System Bold" size="12.0" />
               </font>
            </Label>
            <TextArea fx:id="txtObservacion" prefHeight="80.0" promptText="Detalle el motivo de la salida..." wrapText="true" />
            
            <HBox alignment="CENTER" spacing="10.0" VBox.vgrow="ALWAYS">
               <children>
                  <Button maxWidth="1.7976931348623157E308" mnemonicParsing="false" onAction="#registrarSalida" prefHeight="40.0" style="-fx-background-color: #e74c3c; -fx-text-fill: white; -fx-font-weight: bold; -fx-cursor: hand;" text="REGISTRAR SALIDA" HBox.hgrow="ALWAYS">
                     <font>
                        <Font size="14.0" />
                     </font>
                  </Button>
               </children>
            </HBox>
         </children>
      </VBox>

      <!-- SECCIÓN DERECHA: TABLA DE HISTORIAL -->
      <VBox layoutX="390.0" layoutY="90.0" spacing="10.0" style="-fx-background-color: white; -fx-background-radius: 8; -fx-effect: dropshadow(three-pass-box, rgba(0,0,0,0.1), 5, 0, 0, 0);" AnchorPane.bottomAnchor="20.0" AnchorPane.leftAnchor="390.0" AnchorPane.rightAnchor="20.0" AnchorPane.topAnchor="90.0">
         <padding>
            <Insets bottom="15.0" left="15.0" right="15.0" top="15.0" />
         </padding>
         <children>
            <Label text="Historial de Salidas Registradas" textFill="#2c3e50">
               <font>
                  <Font name="System Bold" size="18.0" />
               </font>
            </Label>
            <TableView fx:id="tblMovimientos" prefHeight="200.0" prefWidth="200.0" VBox.vgrow="ALWAYS">
              <columns>
                <TableColumn fx:id="colId" prefWidth="55.0" text="ID" />
                <TableColumn fx:id="colLibro" prefWidth="180.0" text="Libro" />
                <TableColumn fx:id="colTipo" prefWidth="110.0" text="Tipo" />
                <TableColumn fx:id="colCantidad" prefWidth="75.0" text="Cantidad" />
                <TableColumn fx:id="colFecha" prefWidth="110.0" text="Fecha" />
              </columns>
               <columnResizePolicy>
                  <TableView fx:constant="CONSTRAINED_RESIZE_POLICY" />
               </columnResizePolicy>
            </TableView>
         </children>
      </VBox>
   </children>
</AnchorPane>