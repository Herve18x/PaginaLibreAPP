<?xml version="1.0" encoding="UTF-8"?>

<?import javafx.geometry.Insets?>
<?import javafx.scene.control.Button?>
<?import javafx.scene.control.Label?>
<?import javafx.scene.control.TableColumn?>
<?import javafx.scene.control.TableView?>
<?import javafx.scene.layout.BorderPane?>
<?import javafx.scene.layout.HBox?>
<?import javafx.scene.layout.VBox?>
<?import javafx.scene.text.Font?>

<BorderPane prefHeight="600.0" prefWidth="900.0" style="-fx-background-color: #f4f6f9;" xmlns="http://javafx.com/javafx/21" xmlns:fx="http://javafx.com/fxml/1" fx:controller="org.paginalibre.controller.ReportesBodegaController">
   <top>
      <HBox alignment="CENTER_LEFT" spacing="15.0" style="-fx-background-color: #2c3e50; -fx-padding: 15;">
         <children>
            <Button mnemonicParsing="false" onAction="#handleRegresar" style="-fx-background-color: #34495e; -fx-text-fill: white; -fx-font-weight: bold;" text="← Regresar" />
            <Label text="REPORTES Y MOVIMIENTOS DE BODEGA" textFill="WHITE">
               <font>
                  <Font name="System Bold" size="18.0" />
               </font>
            </Label>
         </children>
      </HBox>
   </top>
   <center>
      <VBox spacing="15.0" BorderPane.alignment="CENTER">
         <padding>
            <Insets bottom="20.0" left="20.0" right="20.0" top="20.0" />
         </padding>
         <children>
            <Label text="Historial General de Entradas, Salidas y Mermas" textFill="#2c3e50">
               <font>
                  <Font name="System Bold" size="14.0" />
               </font>
            </Label>
            <TableView fx:id="tblReportes" prefHeight="450.0" VBox.vgrow="ALWAYS">
               <columns>
                  <TableColumn fx:id="colId" prefWidth="60.0" text="ID" />
                  <TableColumn fx:id="colIsbn" prefWidth="120.0" text="ISBN" />
                  <TableColumn fx:id="colTipo" prefWidth="100.0" text="Tipo" />
                  <TableColumn fx:id="colCantidad" prefWidth="80.0" text="Cantidad" />
                  <TableColumn fx:id="colFecha" prefWidth="150.0" text="Fecha / Hora" />
                  <TableColumn fx:id="colObservacion" prefWidth="250.0" text="Observación / Motivo" />
               </columns>
               <columnResizePolicy>
                  <TableView fx:constant="CONSTRAINED_RESIZE_POLICY" />
               </columnResizePolicy>
            </TableView>
         </children>
      </VBox>
   </center>
</BorderPane>
