<?xml version="1.0" encoding="UTF-8"?>

<?import javafx.geometry.Insets?>
<?import javafx.scene.control.Button?>
<?import javafx.scene.control.Label?>
<?import javafx.scene.control.ScrollPane?>
<?import javafx.scene.layout.BorderPane?>
<?import javafx.scene.layout.HBox?>
<?import javafx.scene.layout.StackPane?>
<?import javafx.scene.layout.TilePane?>
<?import javafx.scene.layout.VBox?>
<?import javafx.scene.text.Font?>

<BorderPane prefHeight="800.0" prefWidth="1200.0" stylesheets="@dashboard.css" styleClass="root" xmlns="http://javafx.com/javafx/21.0.1" xmlns:fx="http://javafx.com/fxml/1" fx:controller="org.paginalibre.controller.BodegaDashboardController">
   <top>
      <StackPane prefHeight="200.0" styleClass="top-header-dark">
         <children>
            <Label text="PANEL DE BODEGA" textFill="WHITE">
               <font>
                  <Font name="Arial Bold" size="36.0" />
               </font>
            </Label>
            
            <HBox alignment="TOP_RIGHT" pickOnBounds="false">
                <padding><Insets top="20" right="30"/></padding>
                <Button onAction="#handleCerrarSesion" styleClass="btn-logout" text="CERRAR SESIÓN" />
            </HBox>

            <HBox visible="false">
               <Label fx:id="lblUsuario" />
               <Label fx:id="lblRol" />
               <Label fx:id="lblAlertasStock" />
               <Label fx:id="lblEntradasHoy" />
               <Label fx:id="lblTitulosCatalogo" />
            </HBox>
         </children>
      </StackPane>
   </top>
   <center>
      <ScrollPane fitToWidth="true" style="-fx-background-color: transparent; -fx-background: transparent;">
         <content>
            <TilePane alignment="CENTER" hgap="30.0" prefColumns="3" style="-fx-background-color: transparent; -fx-padding: 40 40 60 40;" vgap="30.0">
               <children>

                  <!-- 1. Entradas -->
                  <Button onAction="#irIngresoInventario" styleClass="card-button" focusTraversable="false">
                     <graphic>
                        <VBox alignment="TOP_CENTER" prefHeight="160.0" prefWidth="200.0">
                           <Label styleClass="card-icon" text="📥"><VBox.margin><Insets bottom="10.0" /></VBox.margin></Label>
                           <Label text="Entradas" styleClass="card-title"><VBox.margin><Insets bottom="5.0" /></VBox.margin></Label>
                           <Label text="Ingreso de nuevo inventario." textAlignment="CENTER" wrapText="true" styleClass="card-description" />
                        </VBox>
                     </graphic>
                  </Button>

                  <!-- 2. Salidas -->
                  <Button onAction="#irSalidaInventario" styleClass="card-button" focusTraversable="false">
                     <graphic>
                        <VBox alignment="TOP_CENTER" prefHeight="160.0" prefWidth="200.0">
                           <Label styleClass="card-icon" text="📤"><VBox.margin><Insets bottom="10.0" /></VBox.margin></Label>
                           <Label text="Salidas" styleClass="card-title"><VBox.margin><Insets bottom="5.0" /></VBox.margin></Label>
                           <Label text="Registro de salidas de bodega." textAlignment="CENTER" wrapText="true" styleClass="card-description" />
                        </VBox>
                     </graphic>
                  </Button>

                  <!-- 3. Nuevo Libro -->
                  <Button onAction="#abrirNuevoLibro" styleClass="card-button" focusTraversable="false">
                     <graphic>
                        <VBox alignment="TOP_CENTER" prefHeight="160.0" prefWidth="200.0">
                           <Label styleClass="card-icon" text="📖"><VBox.margin><Insets bottom="10.0" /></VBox.margin></Label>
                           <Label text="Nuevo Libro" styleClass="card-title"><VBox.margin><Insets bottom="5.0" /></VBox.margin></Label>
                           <Label text="Registrar nuevos títulos." textAlignment="CENTER" wrapText="true" styleClass="card-description" />
                        </VBox>
                     </graphic>
                  </Button>

                  <!-- 4. Movimientos -->
                  <Button onAction="#abrirMovimientos" styleClass="card-button" focusTraversable="false">
                     <graphic>
                        <VBox alignment="TOP_CENTER" prefHeight="160.0" prefWidth="200.0">
                           <Label styleClass="card-icon" text="🔄"><VBox.margin><Insets bottom="10.0" /></VBox.margin></Label>
                           <Label text="Movimientos" styleClass="card-title"><VBox.margin><Insets bottom="5.0" /></VBox.margin></Label>
                           <Label text="Historial de movimientos." textAlignment="CENTER" wrapText="true" styleClass="card-description" />
                        </VBox>
                     </graphic>
                  </Button>

                  <!-- 5. Inventario Catálogo -->
                  <Button onAction="#abrirInventario" styleClass="card-button" focusTraversable="false">
                     <graphic>
                        <VBox alignment="TOP_CENTER" prefHeight="160.0" prefWidth="200.0">
                           <Label styleClass="card-icon" text="📚"><VBox.margin><Insets bottom="10.0" /></VBox.margin></Label>
                           <Label text="Inventario" styleClass="card-title"><VBox.margin><Insets bottom="5.0" /></VBox.margin></Label>
                           <Label text="Ver catálogo de libros." textAlignment="CENTER" wrapText="true" styleClass="card-description" />
                        </VBox>
                     </graphic>
                  </Button>
                  
                  <!-- 6. Reportes -->
                  <Button onAction="#abrirReportes" styleClass="card-button" focusTraversable="false">
                     <graphic>
                        <VBox alignment="TOP_CENTER" prefHeight="160.0" prefWidth="200.0">
                           <Label styleClass="card-icon" text="📈"><VBox.margin><Insets bottom="10.0" /></VBox.margin></Label>
                           <Label text="Reportes" styleClass="card-title"><VBox.margin><Insets bottom="5.0" /></VBox.margin></Label>
                           <Label text="Generar informes de bodega." textAlignment="CENTER" wrapText="true" styleClass="card-description" />
                        </VBox>
                     </graphic>
                  </Button>

               </children>
            </TilePane>
         </content>
      </ScrollPane>
   </center>
</BorderPane>
