<?xml version="1.0" encoding="UTF-8"?>

<?import javafx.geometry.Insets?>
<?import javafx.scene.control.Button?>
<?import javafx.scene.control.Label?>
<?import javafx.scene.control.TableColumn?>
<?import javafx.scene.control.TableView?>
<?import javafx.scene.control.TextField?>
<?import javafx.scene.layout.BorderPane?>
<?import javafx.scene.layout.HBox?>
<?import javafx.scene.layout.VBox?>
<?import javafx.scene.text.Font?>

<BorderPane prefHeight="650.0" prefWidth="950.0" xmlns="http://javafx.com/javafx/21" xmlns:fx="http://javafx.com/fxml/1" fx:controller="org.paginalibre.controller.BodegaDashboardController">
   
   <left>
      <VBox prefWidth="210.0" spacing="10.0" style="-fx-background-color: #3B82A6;" BorderPane.alignment="CENTER">
         <children>
            <Button maxWidth="1.7976931348623157E308" mnemonicParsing="false" style="-fx-background-color: white; -fx-border-color: #333; -fx-font-weight: bold;" text="CARGA LA BENDICION" />
            
            <Button fx:id="btnPedidos" maxWidth="1.7976931348623157E308" mnemonicParsing="false" style="-fx-background-color: white; -fx-border-color: #333;" text="PEDIDOS" />
            <Button fx:id="btnMovimientos" maxWidth="1.7976931348623157E308" mnemonicParsing="false" onAction="#abrirMovimientos" style="-fx-background-color: white; -fx-border-color: #333;" text="MOVIMIENTOS INVENTARIO" />
            <Button fx:id="btnInventario" maxWidth="1.7976931348623157E308" mnemonicParsing="false" onAction="#abrirInventario" style="-fx-background-color: white; -fx-border-color: #333;" text="INVENTARIO" />
            
            <Button fx:id="btnReportes" maxWidth="1.7976931348623157E308" mnemonicParsing="false" style="-fx-background-color: white; -fx-border-color: #333;" text="REPORTES" />
            <Button fx:id="btnConfiguracion" maxWidth="1.7976931348623157E308" mnemonicParsing="false" style="-fx-background-color: white; -fx-border-color: #333;" text="configuracion" />
            
            <VBox alignment="BOTTOM_CENTER" VBox.vgrow="ALWAYS">
               <children>
                  <Button fx:id="btnCerrarSesion" maxWidth="1.7976931348623157E308" mnemonicParsing="false" onAction="#cerrarSesion" style="-fx-background-color: #D9534F; -fx-text-fill: white; -fx-font-weight: bold; -fx-border-color: #333;" text="CERRAR SESIÓN" />
               </children>
               <padding>
                  <Insets bottom="10.0" />
               </padding>
            </VBox>
         </children>
         <padding>
            <Insets left="10.0" right="10.0" top="15.0" />
         </padding>
      </VBox>
   </left>

   <center>
      <VBox spacing="15.0" BorderPane.alignment="CENTER">
         <padding>
            <Insets bottom="15.0" left="15.0" right="15.0" top="15.0" />
         </padding>
         <children>
            <HBox alignment="CENTER_RIGHT" spacing="10.0">
               <children>
                  <Label fx:id="lblFecha" style="-fx-background-color: white; -fx-border-color: #aaa; -fx-padding: 4 8 4 8;" text="27 DE AGOSTO" />
                  <Label fx:id="lblNotificaciones" style="-fx-background-color: white; -fx-border-color: #aaa; -fx-padding: 4 8 4 8;" text="NOTIFICACIONES" />
                  <Label fx:id="lblUsuario" style="-fx-background-color: white; -fx-border-color: #aaa; -fx-padding: 4 8 4 8;" text="Luis" />
                  <Label fx:id="lblRol" style="-fx-background-color: white; -fx-border-color: #aaa; -fx-padding: 4 8 4 8;" text="bodega" />
               </children>
            </HBox>

            <Label style="-fx-border-color: #aaa; -fx-padding: 5 15 5 15;" text="PANEL DE BODEGA">
               <font>
                  <Font size="20.0" />
               </font>
            </Label>

            <VBox style="-fx-border-color: #aaa; -fx-padding: 10;" VBox.vgrow="ALWAYS">
               <children>
                  <HBox alignment="CENTER_RIGHT" spacing="5.0">
                     <children>
                        <Label text="🔍" />
                        <TextField fx:id="txtBuscar" prefWidth="200.0" promptText="buscar" style="-fx-background-color: white; -fx-border-color: #aaa;" />
                     </children>
                     <VBox.margin>
                        <Insets bottom="10.0" />
                     </VBox.margin>
                  </HBox>
                  
                  <TableView fx:id="tablaContenido" VBox.vgrow="ALWAYS">
                    <placeholder>
                        <Label text="Tabla sin contenido" />
                    </placeholder>
                    <columns>
                      <TableColumn fx:id="colId" prefWidth="60.0" text="#" />
                      <TableColumn fx:id="colCategoriaNombre" prefWidth="640.0" text="Categoría / Nombre" />
                    </columns>
                     <columnResizePolicy>
                        <TableView fx:constant="CONSTRAINED_RESIZE_POLICY" />
                     </columnResizePolicy>
                  </TableView>
               </children>
            </VBox>
         </children>
      </VBox>
   </center>
</BorderPane>