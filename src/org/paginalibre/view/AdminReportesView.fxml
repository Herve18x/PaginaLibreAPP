<?xml version="1.0" encoding="UTF-8"?>
<?import javafx.scene.control.*?><?import javafx.scene.layout.*?><?import javafx.geometry.Insets?>
<BorderPane xmlns="http://javafx.com/javafx/21" xmlns:fx="http://javafx.com/fxml/1" fx:controller="org.paginalibre.controller.AdminReportesController">
 <top><HBox spacing="12" alignment="CENTER_LEFT" style="-fx-background-color:#263238;-fx-padding:14;"><children><Button text="← Regresar" onAction="#regresar"/><Label text="REPORTES ADMINISTRATIVOS" style="-fx-text-fill:white;-fx-font-size:20px;-fx-font-weight:bold;"/></children></HBox></top>
 <center><TabPane><tabs>
  <Tab text="Ventas" closable="false"><content><VBox spacing="10"><padding><Insets top="15" right="15" bottom="15" left="15"/></padding><HBox spacing="8"><ComboBox fx:id="cmbPeriodo" prefWidth="140"/><DatePicker fx:id="dpDesde"/><DatePicker fx:id="dpHasta"/><Button text="Aplicar filtros" onAction="#filtrar"/></HBox><TableView fx:id="tblVentas" VBox.vgrow="ALWAYS"><columns><TableColumn fx:id="colId" text="ID"/><TableColumn fx:id="colFecha" text="Fecha"/><TableColumn fx:id="colSubtotal" text="Subtotal"/><TableColumn fx:id="colDescuento" text="Descuento"/><TableColumn fx:id="colTotal" text="Total"/><TableColumn fx:id="colEstado" text="Estado"/><TableColumn fx:id="colCliente" text="Cliente"/><TableColumn fx:id="colCajero" text="Cajero"/></columns></TableView></VBox></content></Tab>
  <Tab text="Inventario" closable="false"><content><VBox spacing="10"><padding><Insets top="15" right="15" bottom="15" left="15"/></padding><HBox spacing="8"><Button text="Más vendidos (período)" onAction="#filtrar"/><Button text="Stock valorizado" onAction="#verStockValorizado"/></HBox><TableView fx:id="tblLibros" VBox.vgrow="ALWAYS"><columns><TableColumn fx:id="colIsbn" text="ISBN"/><TableColumn fx:id="colTitulo" text="Libro"/><TableColumn fx:id="colCantidad" text="Vendidos"/><TableColumn fx:id="colStock" text="Stock"/><TableColumn fx:id="colValor" text="Valor inventario"/></columns></TableView></VBox></content></Tab>
 </tabs></TabPane></center>
</BorderPane>
