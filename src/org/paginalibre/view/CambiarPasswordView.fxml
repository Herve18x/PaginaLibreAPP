<?xml version="1.0" encoding="UTF-8"?>

<?import javafx.geometry.Insets?>
<?import javafx.scene.control.Button?>
<?import javafx.scene.control.Label?>
<?import javafx.scene.control.PasswordField?>
<?import javafx.scene.layout.VBox?>
<?import javafx.scene.text.Font?>

<VBox alignment="CENTER" prefHeight="380.0" prefWidth="400.0" spacing="12" stylesheets="@/org/paginalibre/view/style/login.css" xmlns="http://javafx.com/javafx/21.0.1" xmlns:fx="http://javafx.com/fxml/1" fx:controller="org.paginalibre.controller.CambiarPasswordController">

    <padding>
        <Insets bottom="30" left="30" right="30" top="30" />
    </padding>

    <Label styleClass="subtitulo-login" text="Cambiar Contraseña">
        <font>
            <Font name="System Bold" size="20.0" />
        </font>
    </Label>

    <PasswordField fx:id="txtPasswordActual" maxWidth="Infinity" promptText="Contraseña Actual">
        <font>
            <Font name="System" size="12.0" />
        </font>
    </PasswordField>

    <PasswordField fx:id="txtNuevaPassword" maxWidth="Infinity" promptText="Nueva Contraseña">
        <font>
            <Font name="System" size="12.0" />
        </font>
    </PasswordField>

    <PasswordField fx:id="txtConfirmarPassword" maxWidth="Infinity" promptText="Confirmar Nueva Contraseña">
        <font>
            <Font name="System" size="12.0" />
        </font>
    </PasswordField>

    <Label fx:id="lblMensaje" alignment="CENTER" maxWidth="Infinity" styleClass="mensaje-error" wrapText="true" />

    <Button fx:id="btnGuardar" defaultButton="true" maxWidth="Infinity" onAction="#eventoGuardar" text="Guardar Cambio">
        <font>
            <Font name="System Bold" size="12.0" />
        </font>
    </Button>

    <Button fx:id="btnCancelar" maxWidth="Infinity" onAction="#eventoCancelar" text="Cancelar">
        <font>
            <Font name="System Bold" size="12.0" />
        </font>
    </Button>

</VBox>
