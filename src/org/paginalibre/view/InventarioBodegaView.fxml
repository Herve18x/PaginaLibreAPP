<?xml version="1.0" encoding="UTF-8"?>

<?import javafx.geometry.Insets?>
<?import javafx.scene.control.Button?>
<?import javafx.scene.control.DatePicker?>
<?import javafx.scene.control.Label?>
<?import javafx.scene.control.TableColumn?>
<?import javafx.scene.control.TableView?>
<?import javafx.scene.control.TextField?>
<?import javafx.scene.layout.BorderPane?>
<?import javafx.scene.layout.GridPane?>
<?import javafx.scene.layout.HBox?>
<?import javafx.scene.layout.VBox?>
<?import javafx.scene.text.Font?>

<BorderPane prefHeight="650.0" prefWidth="1050.0" xmlns="http://javafx.com/javafx/21" xmlns:fx="http://javafx.com/fxml/1" fx:controller="org.paginalibre.controller.InventarioBodegaController">
   
   <!-- ENCABEZADO SUPERIOR -->
   <top>
      <HBox alignment="CENTER_LEFT" spacing="15.0" style="-fx-background-color: #3B82A6;" BorderPane.alignment="CENTER">
         <padding>
            <Insets bottom="12.0" left="20.0" right="20.0" top="12.0" />
         </padding>
         <children>
            <Button fx:id="btnRegresar" onAction="#regresarDashboard" style="-fx-background-color: white; -fx-text-fill: #333; -fx-font-weight: bold; -fx-border-color: #333;" text="← REGRESAR" />
            <Label style="-fx-font-size: 18px; -fx-font-weight: bold; -fx-text-fill: white;" text="PANEL DE GESTIÓN DE INVENTARIO" />
         </children>
      </HBox>
   </top>

   <!-- ÁREA CENTRAL (TABLA DE LIBROS Y PANEL DE EDICIÓN) -->
   <center>
      <HBox spacing="15.0" BorderPane.alignment="CENTER">
         <padding>
            <Insets bottom="15.0" left="15.0" right="15.0" top="15.0" />
         </padding>
         <children>
            
            <!-- CONTENEDOR IZQUIERDO: BUSCADOR Y TABLA -->
            <VBox spacing="10.0" VBox.vgrow="ALWAYS" HBox.hgrow="ALWAYS">
               <children>
                  <HBox alignment="CENTER_RIGHT" spacing="5.0">
                     <children>
                        <Label text="🔍" />
                        <TextField fx:id="txtBuscar" prefWidth="250.0" promptText="Buscar por ISBN o Título..." style="-fx-background-color: white; -fx-border-color: #aaa;" />
                     </children>
                  </HBox>
                  
                  <TableView fx:id="tablaLibros" VBox.vgrow="ALWAYS">
                     <placeholder>
                        <Label text="No hay libros registrados o activos." />
                     </placeholder>
                     <columns>
                        <TableColumn fx:id="colIsbn" prefWidth="110.0" text="ISBN" />
                        <TableColumn fx:id="colTitulo" prefWidth="200.0" text="Título" />
                        <TableColumn fx:id="colPrecio" prefWidth="80.0" text="Precio (Q)" />
                        <TableColumn fx:id="colStock" prefWidth="75.0" text="Stock" />
                        <TableColumn fx:id="colEditorial" prefWidth="100.0" text="Editorial" />
                        <TableColumn fx:id="colFecha" prefWidth="95.0" text="Fecha Pub." />
                     </columns>
                     <columnResizePolicy>
                        <TableView fx:constant="CONSTRAINED_RESIZE_POLICY" />
                     </columnResizePolicy>
                  </TableView>
               </children>
            </VBox>

            <!-- PANEL DERECHO: EDICIÓN DE LIBRO SELECCIONADO -->
            <VBox prefWidth="320.0" spacing="12.0" style="-fx-border-color: #aaa; -fx-background-color: #F8F9FA; -fx-padding: 15;">
               <children>
                  <Label style="-fx-font-weight: bold; -fx-font-size: 14px;" text="EDITAR INFORMACIÓN" />
                  
                  <VBox spacing="8.0" VBox.vgrow="ALWAYS">
                     <children>
                        <Label text="ISBN (No editable):" />
                        <TextField fx:id="txtIsbn" disable="true" style="-fx-background-color: #e9ecef; -fx-border-color: #ccc;" />

                        <Label text="Título del Libro:" />
                        <TextField fx:id="txtTitulo" style="-fx-background-color: white; -fx-border-color: #ccc;" />

                        <HBox spacing="10.0">
                           <children>
                              <VBox HBox.hgrow="ALWAYS">
                                 <children>
                                    <Label text="Precio (Q):" />
                                    <TextField fx:id="txtPrecio" style="-fx-background-color: white; -fx-border-color: #ccc;" />
                                 </children>
                              </VBox>
                              <VBox HBox.hgrow="ALWAYS">
                                 <children>
                                    <Label text="Stock Actual:" />
                                    <TextField fx:id="txtStock" style="-fx-background-color: white; -fx-border-color: #ccc;" />
                                 </children>
                              </VBox>
                           </children>
                        </HBox>

                        <HBox spacing="10.0">
                           <children>
                              <VBox HBox.hgrow="ALWAYS">
                                 <children>
                                    <Label text="Stock Mínimo:" />
                                    <TextField fx:id="txtStockMinimo" style="-fx-background-color: white; -fx-border-color: #ccc;" />
                                 </children>
                              </VBox>
                              <VBox HBox.hgrow="ALWAYS">
                                 <children>
                                    <Label text="ID Categoría:" />
                                    <TextField fx:id="txtCategoria" style="-fx-background-color: white; -fx-border-color: #ccc;" />
                                 </children>
                              </VBox>
                           </children>
                        </HBox>

                        <Label text="NIT Editorial:" />
                        <TextField fx:id="txtEditorial" style="-fx-background-color: white; -fx-border-color: #ccc;" />

                        <Label text="Fecha de Publicación:" />
                        <DatePicker fx:id="dpFechaPub" maxWidth="1.7976931348623157E308" style="-fx-border-color: #ccc;" />
                     </children>
                  </VBox>

                  <HBox spacing="10.0">
                     <children>
                        <Button maxWidth="1.7976931348623157E308" mnemonicParsing="false" onAction="#guardarCambios" style="-fx-background-color: #2F6FED; -fx-text-fill: white; -fx-font-weight: bold;" text="GUARDAR" HBox.hgrow="ALWAYS" />
                        <Button maxWidth="1.7976931348623157E308" mnemonicParsing="false" onAction="#limpiarFormulario" style="-fx-background-color: #6c757d; -fx-text-fill: white;" text="LIMPIAR" HBox.hgrow="ALWAYS" />
                     </children>
                  </HBox>
               </children>
            </VBox>

         </children>
      </HBox>
   </center>
</BorderPane>