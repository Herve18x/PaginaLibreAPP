<?xml version="1.0" encoding="UTF-8"?>

<?import javafx.geometry.Insets?>
<?import javafx.scene.control.Button?>
<?import javafx.scene.control.Label?>
<?import javafx.scene.control.TableColumn?>
<?import javafx.scene.control.TableView?>
<?import javafx.scene.control.TextField?>
<?import javafx.scene.layout.BorderPane?>
<?import javafx.scene.layout.HBox?>
<?import javafx.scene.layout.VBox?>
<?import javafx.scene.text.Font?>

<BorderPane prefHeight="600.0" prefWidth="800.0" xmlns="http://javafx.com/javafx/21.0.1" xmlns:fx="http://javafx.com/fxml/1" fx:controller="org.paginalibre.controller.ReembolsosController">
   <center>
      <VBox spacing="10.0" BorderPane.alignment="CENTER">
         <padding>
            <Insets bottom="15.0" left="15.0" right="15.0" top="15.0" />
         </padding>
         <children>
            <HBox alignment="CENTER_LEFT" spacing="10.0">
               <children>
                  <Button mnemonicParsing="false" onAction="#regresarDashboard" style="-fx-background-color: #3b0a24; -fx-text-fill: white;" text="← Volver al Dashboard" />
                  <Label text="PANEL DE REEMBOLSOS Y DEVOLUCIONES">
                     <font>
                        <Font size="18.0" />
                     </font>
                  </Label>
               </children>
            </HBox>
            <VBox spacing="10.0" style="-fx-border-color: #aaa; -fx-padding: 10;" VBox.vgrow="ALWAYS">
               <children>
                  <HBox alignment="CENTER_RIGHT" spacing="10.0">
                     <children>
                        <TextField fx:id="txtBuscar" promptText="Buscar venta..." style="-fx-background-color: white; -fx-border-color: #aaa;" />
                        <Button mnemonicParsing="false" onAction="#procesarReembolso" style="-fx-background-color: #d9534f; -fx-text-fill: white; -fx-font-weight: bold;" text="Procesar Reembolso" />
                     </children>
                  </HBox>
                  <TableView fx:id="tblVentas" VBox.vgrow="ALWAYS">
                    <columns>
                      <TableColumn fx:id="colIdVenta" prefWidth="75.0" text="No. Venta" />
                      <TableColumn fx:id="colFecha" prefWidth="150.0" text="Fecha" />
                      <TableColumn fx:id="colTotal" prefWidth="100.0" text="Total" />
                      <TableColumn fx:id="colEstado" prefWidth="120.0" text="Estado" />
                      <TableColumn fx:id="colCliente" prefWidth="150.0" text="CUI Cliente" />
                      <TableColumn fx:id="colUsuario" prefWidth="100.0" text="Atendido por" />
                    </columns>
                  </TableView>
               </children>
            </VBox>
         </children>
      </VBox>
   </center>
</BorderPane>