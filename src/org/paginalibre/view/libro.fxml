<?xml version="1.0" encoding="UTF-8"?>

<?import javafx.geometry.Insets?>
<?import javafx.scene.control.Button?>
<?import javafx.scene.control.Label?>
<?import javafx.scene.control.TableColumn?>
<?import javafx.scene.control.TableView?>
<?import javafx.scene.control.TextField?>
<?import javafx.scene.layout.BorderPane?>
<?import javafx.scene.layout.HBox?>
<?import javafx.scene.layout.VBox?>

<BorderPane prefHeight="600.0"
            prefWidth="1100.0"
            xmlns="http://javafx.com/javafx/21.0.1"
            xmlns:fx="http://javafx.com/fxml/1"
            fx:controller="org.paginalibre.controller.LibroController">

    <top>

        <VBox spacing="15.0">

            <padding>
                <Insets top="20.0"
                        right="20.0"
                        bottom="10.0"
                        left="20.0" />
            </padding>

            <HBox alignment="CENTER_LEFT"
                  spacing="15.0">

                <Button text="REGRESAR"
                        onAction="#regresarDashboard" />

                <Label text="GESTIÓN DE LIBROS"
                       style="-fx-font-size: 22px; -fx-font-weight: bold;" />

            </HBox>

            <HBox alignment="CENTER_LEFT"
                  spacing="10.0">

                <Label text="ISBN:" />

                <TextField fx:id="txtBuscarIsbn"
                           prefWidth="260.0"
                           promptText="Ingrese ISBN" />

                <Button text="BUSCAR"
                        onAction="#buscarPorIsbn" />

                <Button text="MOSTRAR TODOS"
                        onAction="#mostrarTodos" />

            </HBox>

        </VBox>

    </top>

    <center>

        <VBox>

            <padding>
                <Insets top="10.0"
                        right="20.0"
                        bottom="20.0"
                        left="20.0" />
            </padding>

            <TableView fx:id="tablaLibros"
                       prefHeight="480.0">

                <columns>

                    <TableColumn fx:id="colIsbn"
                                 prefWidth="145.0"
                                 text="ISBN" />

                    <TableColumn fx:id="colTitulo"
                                 prefWidth="220.0"
                                 text="TÍTULO" />

                    <TableColumn fx:id="colFechaPublicacion"
                                 prefWidth="145.0"
                                 text="FECHA PUBLICACIÓN" />

                    <TableColumn fx:id="colPrecio"
                                 prefWidth="100.0"
                                 text="PRECIO" />

                    <TableColumn fx:id="colCategoria"
                                 prefWidth="110.0"
                                 text="CATEGORÍA" />

                    <TableColumn fx:id="colEditorial"
                                 prefWidth="130.0"
                                 text="EDITORIAL" />

                    <TableColumn fx:id="colStockActual"
                                 prefWidth="110.0"
                                 text="STOCK ACTUAL" />

                    <TableColumn fx:id="colStockMinimo"
                                 prefWidth="110.0"
                                 text="STOCK MÍNIMO" />

                </columns>

            </TableView>

        </VBox>

    </center>

</BorderPane>