<?xml version="1.0" encoding="UTF-8"?>

<?import javafx.scene.control.Button?>
<?import javafx.scene.control.Label?>
<?import javafx.scene.control.TableColumn?>
<?import javafx.scene.control.TableView?>
<?import javafx.scene.control.TextField?>
<?import javafx.scene.layout.AnchorPane?>
<?import javafx.scene.layout.HBox?>

<AnchorPane
        prefHeight="600.0"
        prefWidth="900.0"
        style="-fx-background-color: #eeeeee;"
        xmlns="http://javafx.com/javafx/21.0.1"
        xmlns:fx="http://javafx.com/fxml/1"
        fx:controller="org.paginalibre.controller.LibroController">

    <children>

        <!-- TÍTULO -->
        <Label
                layoutX="15.0"
                layoutY="14.0"
                text="Catálogo de libros"
                style="-fx-font-size: 18px; -fx-font-weight: bold;" />

        <!-- BUSCADOR -->
        <TextField
                fx:id="txtBuscar"
                layoutY="52.0"
                prefHeight="26.0"
                promptText="Buscar por título o ISBN..."
                AnchorPane.leftAnchor="15.0"
                AnchorPane.rightAnchor="70.0" />

        <Button
                fx:id="btnBuscar"
                layoutY="52.0"
                mnemonicParsing="false"
                prefHeight="26.0"
                prefWidth="52.0"
                text="Buscar"
                AnchorPane.rightAnchor="12.0" />

        <!-- TABLA -->
        <TableView
                fx:id="tablaLibros"
                AnchorPane.bottomAnchor="45.0"
                AnchorPane.leftAnchor="4.0"
                AnchorPane.rightAnchor="4.0"
                AnchorPane.topAnchor="85.0">

            <columns>

                <TableColumn
                        fx:id="colIsbn"
                        prefWidth="200.0"
                        text="ISBN" />
                
                <TableColumn
                        fx:id="colTitulo"
                        prefWidth="200.0"
                        text="TITULO" />
                
                <TableColumn
                        fx:id="colFechaPublicacion"
                        prefWidth="200.0"
                        text="Fecha de Publicacion" />
                
                <TableColumn
                        fx:id="colPrecio"
                        prefWidth="200.0"
                        text="PRECIO" />
                
                <TableColumn
                        fx:id="colIdCategoria"
                        prefWidth="200.0"
                        text="ID Categoria" />

                <TableColumn
                        fx:id="colNitEditorial"
                        prefWidth="300.0"
                        text="Nit" />

                <TableColumn
                        fx:id="colStockActual"
                        prefWidth="180.0"
                        text="Stock Actual" />

                <TableColumn
                        fx:id="colStockMinimo"
                        prefWidth="210.0"
                        text="Stock Minimo" />

            </columns>

        </TableView>

        <!-- BOTONES -->
        <HBox
                alignment="CENTER_RIGHT"
                spacing="8.0"
                AnchorPane.bottomAnchor="10.0"
                AnchorPane.leftAnchor="10.0"
                AnchorPane.rightAnchor="12.0">

            <children>

                <Button
                        fx:id="btnEditar"
                        mnemonicParsing="false"
                        text="Editar" />

                <Button
                        fx:id="btnActivarDesactivar"
                        mnemonicParsing="false"
                        text="Activar/Desactivar" />

                <Button
                        fx:id="btnAgregarLibro"
                        mnemonicParsing="false"
                        text="Agregar nuevo libro" />

                <Button
                        fx:id="btnRegistrarStock"
                        mnemonicParsing="false"
                        text="Registrar nuevo stock" />

                <Button
                        fx:id="btnRegistrarSalida"
                        mnemonicParsing="false"
                        text="Registrar salidas de libros" />

            </children>

        </HBox>

    </children>

</AnchorPane>