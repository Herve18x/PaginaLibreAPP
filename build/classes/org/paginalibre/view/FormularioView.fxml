<?xml version="1.0" encoding="UTF-8"?>

<?import javafx.geometry.Insets?>
<?import javafx.scene.control.*?>
<?import javafx.scene.layout.*?>

<VBox spacing="15.0" style="-fx-background-color: #ffffff;" xmlns="http://javafx.com/javafx/21.0.1" xmlns:fx="http://javafx.com/fxml/1" fx:controller="org.paginalibre.controller.FormularioViewController">
   <padding>
      <Insets bottom="20.0" left="20.0" right="20.0" top="20.0" />
   </padding>
   <children>
      
      <HBox alignment="CENTER_LEFT" spacing="10.0" style="-fx-border-color: #cccccc; -fx-border-width: 0 0 2 0; -fx-padding: 0 0 10 0;">
         <children>
            <Label fx:id="lblTitulo" style="-fx-font-size: 20px; -fx-font-weight: bold; -fx-text-fill: #333333;" text="FORMULARIO DE USUARIO" />
         </children>
      </HBox>

      <VBox spacing="15.0" style="-fx-background-color: #f9f9f9; -fx-border-color: #e0e0e0; -fx-border-radius: 5; -fx-background-radius: 5;" VBox.vgrow="ALWAYS">
         <padding>
            <Insets bottom="20.0" left="20.0" right="20.0" top="20.0" />
         </padding>
         <children>
            <GridPane hgap="15.0" vgap="15.0">
               <columnConstraints>
                  <ColumnConstraints prefWidth="100.0" />
                  <ColumnConstraints hgrow="ALWAYS" />
                  <ColumnConstraints prefWidth="100.0" />
                  <ColumnConstraints hgrow="ALWAYS" />
               </columnConstraints>
               <children>
                  <Label text="Usuario:" GridPane.columnIndex="0" GridPane.rowIndex="0" />
                  <TextField fx:id="txtUsername" promptText="ej. jperez" GridPane.columnIndex="1" GridPane.rowIndex="0" />

                  <Label text="Contraseña:" GridPane.columnIndex="2" GridPane.rowIndex="0" />
                  <PasswordField fx:id="txtPassword" promptText="Nueva o cambio" GridPane.columnIndex="3" GridPane.rowIndex="0" />

                  <Label text="Nombre:" GridPane.columnIndex="0" GridPane.rowIndex="1" />
                  <TextField fx:id="txtNombre" promptText="Nombre" GridPane.columnIndex="1" GridPane.rowIndex="1" />

                  <Label text="Apellido:" GridPane.columnIndex="2" GridPane.rowIndex="1" />
                  <TextField fx:id="txtApellido" promptText="Apellido" GridPane.columnIndex="3" GridPane.rowIndex="1" />

                  <Label text="Correo:" GridPane.columnIndex="0" GridPane.rowIndex="2" />
                  <TextField fx:id="txtCorreo" promptText="correo@ejemplo.com" GridPane.columnIndex="1" GridPane.rowIndex="2" />

                  <Label text="Rol:" GridPane.columnIndex="2" GridPane.rowIndex="2" />
                  <ComboBox fx:id="cmbRol" maxWidth="Infinity" promptText="Seleccionar Rol" GridPane.columnIndex="3" GridPane.rowIndex="2" />
               </children>
            </GridPane>

            <Region VBox.vgrow="ALWAYS" />

            <HBox alignment="CENTER_RIGHT" spacing="10.0">
               <children>
                  <Button mnemonicParsing="false" onAction="#cancelar" style="-fx-background-color: #888888; -fx-text-fill: white; -fx-cursor: hand;" text="Cancelar / Regresar" />
                  <Button mnemonicParsing="false" onAction="#guardarUsuario" style="-fx-background-color: #51ADBD; -fx-text-fill: white; -fx-font-weight: bold; -fx-cursor: hand;" text="Guardar Usuario" />
               </children>
            </HBox>
         </children>
      </VBox>

   </children>
</VBox>