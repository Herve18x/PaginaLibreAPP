<?xml version="1.0" encoding="UTF-8"?>

<?import javafx.geometry.Insets?>
<?import javafx.scene.control.Button?>
<?import javafx.scene.control.ComboBox?>
<?import javafx.scene.control.Label?>
<?import javafx.scene.control.TableColumn?>
<?import javafx.scene.control.TableView?>
<?import javafx.scene.control.TextField?>
<?import javafx.scene.layout.ColumnConstraints?>
<?import javafx.scene.layout.GridPane?>
<?import javafx.scene.layout.HBox?>
<?import javafx.scene.layout.RowConstraints?>
<?import javafx.scene.layout.VBox?>

<VBox prefHeight="680.0" prefWidth="850.0" spacing="15.0" style="-fx-background-color: #ffffff;" xmlns="http://javafx.com/javafx/21.0.1" xmlns:fx="http://javafx.com/fxml/1" fx:controller="org.paginalibre.controller.UsuarioController">
   <padding>
      <Insets bottom="20.0" left="20.0" right="20.0" top="20.0" />
   </padding>
   <children>
      
      <HBox alignment="CENTER_LEFT" spacing="10.0" style="-fx-border-color: #cccccc; -fx-border-width: 0 0 2 0; -fx-padding: 0 0 10 0;">
         <children>
            <Button mnemonicParsing="false" onAction="#cerrarVentana" style="-fx-background-color: #888888; -fx-text-fill: white; -fx-font-weight: bold; -fx-cursor: hand;" text="← Volver" />
            <Label style="-fx-font-size: 18px; -fx-font-weight: bold; -fx-text-fill: #333333;" text="GESTIÓN DE USUARIOS" />
         </children>
      </HBox>

      <VBox spacing="10.0" VBox.vgrow="ALWAYS">
         <children>
            <TableView fx:id="tblUsuarios" VBox.vgrow="ALWAYS">
              <columns>
                <TableColumn fx:id="colId" prefWidth="50.0" text="ID" />
                <TableColumn fx:id="colUsername" prefWidth="120.0" text="Usuario" />
                <TableColumn fx:id="colNombre" prefWidth="140.0" text="Nombre" />
                <TableColumn fx:id="colApellido" prefWidth="140.0" text="Apellido" />
                <TableColumn fx:id="colCorreo" prefWidth="200.0" text="Correo Electrónico" />
                <TableColumn fx:id="colRol" prefWidth="100.0" text="Rol" />
                <TableColumn fx:id="colActivo" prefWidth="80.0" text="Estado" />
              </columns>
            </TableView>

            <HBox alignment="CENTER_RIGHT" spacing="10.0">
               <children>
                  <Button mnemonicParsing="false" onAction="#toggleEstado" style="-fx-background-color: #d9534f; -fx-text-fill: white; -fx-font-weight: bold; -fx-cursor: hand;" text="Activar / Desactivar" />
               </children>
            </HBox>
         </children>
      </VBox>

      <VBox spacing="10.0" style="-fx-background-color: #f9f9f9; -fx-border-color: #51ADBD; -fx-border-width: 1.5; -fx-border-radius: 5; -fx-background-radius: 5;">
         <padding>
            <Insets bottom="15.0" left="15.0" right="15.0" top="15.0" />
         </padding>
         <children>
            <Label fx:id="lblTituloFormulario" style="-fx-font-size: 14px; -fx-font-weight: bold; -fx-text-fill: #333333;" text="REGISTRAR NUEVO USUARIO" />
            <GridPane hgap="10.0" vgap="10.0">
               <columnConstraints>
                  <ColumnConstraints prefWidth="80.0" />
                  <ColumnConstraints hgrow="ALWAYS" />
                  <ColumnConstraints prefWidth="140.0" />
                  <ColumnConstraints hgrow="ALWAYS" />
               </columnConstraints>
               <children>
                  <Label text="Usuario:" GridPane.columnIndex="0" GridPane.rowIndex="0" />
                  <TextField fx:id="txtUsername" promptText="ej. jperez" GridPane.columnIndex="1" GridPane.rowIndex="0" />

                  <Button mnemonicParsing="false" onAction="#abrirCambiarPassword" prefHeight="25.0" prefWidth="249.0" style="-fx-font-weight: bold; -fx-cursor: hand;" text="Cambiar Contraseña" GridPane.columnIndex="3" />

                  <Label text="Nombre:" GridPane.columnIndex="0" GridPane.rowIndex="1" />
                  <TextField fx:id="txtNombre" promptText="Nombre" GridPane.columnIndex="1" GridPane.rowIndex="1" />

                  <Label text="Apellido:" GridPane.columnIndex="2" GridPane.rowIndex="1" />
                  <TextField fx:id="txtApellido" promptText="Apellido" GridPane.columnIndex="3" GridPane.rowIndex="1" />

                  <Label text="Correo:" GridPane.columnIndex="0" GridPane.rowIndex="2" />
                  <TextField fx:id="txtCorreo" promptText="correo@ejemplo.com" GridPane.columnIndex="1" GridPane.rowIndex="2" />

                  <Label text="Rol:" GridPane.columnIndex="2" GridPane.rowIndex="2" />
                  <ComboBox fx:id="cmbRol" maxWidth="Infinity" promptText="Seleccionar Rol" GridPane.columnIndex="3" GridPane.rowIndex="2" />
               </children>
               <rowConstraints>
                  <RowConstraints />
                  <RowConstraints />
                  <RowConstraints />
               </rowConstraints>
            </GridPane>

            <HBox alignment="CENTER_RIGHT" spacing="10.0">
               <children>
                  <Button mnemonicParsing="false" onAction="#limpiarFormulario" style="-fx-background-color: #888888; -fx-text-fill: white; -fx-cursor: hand;" text="Limpiar Selección" />
                  <Button mnemonicParsing="false" onAction="#guardarUsuario" style="-fx-background-color: #51ADBD; -fx-text-fill: white; -fx-font-weight: bold; -fx-cursor: hand;" text="Guardar Usuario" />
               </children>
            </HBox>
         </children>
      </VBox>

   </children>
</VBox>
